rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasRole() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasRole() && role() == 'admin'; }
    function isEditor() { return hasRole() && role() in ['admin', 'editor']; }
    function stamped() { return request.resource.data.updatedBy == request.auth.uid; }

    // Any user with a role may read everything, including costs.
    match /{collection}/{id} {
      allow read: if hasRole();
    }

    // Data entry, one document per month (perMonth/YYYY-MM …), stamped with the writer's uid.
    match /perMonth/{id} { allow create, update: if isEditor() && stamped(); allow delete: if isEditor(); }
    match /lotMonth/{id} { allow create, update: if isEditor() && stamped(); allow delete: if isEditor(); }
    match /absenceMonth/{id} { allow create, update: if isEditor() && stamped(); allow delete: if isEditor(); }
    match /costMonthly/{id} { allow create, update: if isEditor() && stamped(); allow delete: if isEditor(); }
    match /opsMonthly/{id} { allow create, update: if isEditor() && stamped(); allow delete: if isEditor(); }
    match /otdMonthly/{id} { allow create, update: if isEditor() && stamped(); allow delete: if isEditor(); }
    match /images/{id} { allow create, update: if isEditor() && stamped() && request.resource.data.data.size() < 900000; allow delete: if isEditor(); }

    // Settings and accounts: admins only.
    match /lines/{id} { allow write: if isAdmin(); }
    match /workers/{id} { allow write: if isAdmin(); }
    match /targets/{id} { allow write: if isAdmin(); }
    match /setters/{id} { allow write: if isAdmin(); }
    match /settings/{id} { allow write: if isAdmin(); }
    match /monthlySummary/{id} { allow write: if isAdmin(); }
    match /users/{uid} { allow write: if isAdmin(); }
  }
}
